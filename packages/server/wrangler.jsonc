{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evt",
  "main": "src/index.ts",
  // The web client is served as static files; only /api/* reaches the Worker.
  // Build it first: pnpm --filter @evt/web build
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "MATCH", "class_name": "Match" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Match"] }],
  "observability": { "enabled": true }
}
