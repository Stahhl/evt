{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evt",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "MATCH", "class_name": "Match" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Match"] }],
  "observability": { "enabled": true }
}
